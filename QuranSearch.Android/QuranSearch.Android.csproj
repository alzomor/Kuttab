<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.quransearch.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-x86;android-x64;android-arm64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <!-- Disable AOT compilation to avoid SDK resolution issues -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <!-- Disable IL Linker trimming to prevent ReactiveUI issues -->
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../QuranSearch.Core/QuranSearch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.1" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.2.6" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="Assets\**" />
    <!-- Include localization JSON files as Android assets -->
    <AndroidAsset Include="..\Localization\*.json">
      <Link>Localization/%(FileName)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
</Project>