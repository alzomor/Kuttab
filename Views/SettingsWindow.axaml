<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kuttab.ViewModels"
        xmlns:services="using:Kuttab.Core.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        x:Class="Kuttab.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Localization.SettingsTitle}"
        Width="600" Height="550"
        Background="#F5F5DC"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2C5F2D"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        
        <Style Selector="ComboBox.settings-combo">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C5F2D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
        
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#2C5F2D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#2C5F2D"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2C5F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#3A7A3C"/>
        </Style>
        
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#8B7355"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#A68968"/>
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Language Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="{Binding Localization.LanguageSettingsTitle}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="{Binding Localization.SelectLanguageLabel}" Width="150"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="services:LanguageOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search Domain Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="{Binding Localization.SearchDomainTitle}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Classes="label" Text="{Binding Localization.SearchInLabel}" Width="150"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding SearchDomainOptions}"
                                  SelectedItem="{Binding SelectedSearchDomain}"
                                  x:Name="SearchDomainComboBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:SearchDomainOption" x:CompileBindings="False">
                                    <TextBlock Text="{Binding $parent[Window].DataContext.Localization[DisplayKey]}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Single Surah Selection -->
                    <StackPanel IsVisible="{Binding IsSingleSurahSelected}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="{Binding Localization.SurahNumberLabel}" Width="150"/>
                            <ComboBox Classes="settings-combo"
                                      ItemsSource="{Binding SurahList}"
                                      SelectedItem="{Binding SelectedStartSurah}"
                                      MinWidth="250">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:SurahItem">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Surah Range Selection -->
                    <StackPanel IsVisible="{Binding IsSurahRangeSelected}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Classes="label" Text="{Binding Localization.FromSurahLabel}" Width="150"/>
                            <ComboBox Classes="settings-combo"
                                      ItemsSource="{Binding SurahList}"
                                      SelectedItem="{Binding SelectedStartSurah}"
                                      MinWidth="250">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:SurahItem">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="{Binding Localization.ToSurahLabel}" Width="150"/>
                            <ComboBox Classes="settings-combo"
                                      ItemsSource="{Binding SurahList}"
                                      SelectedItem="{Binding SelectedEndSurah}"
                                      MinWidth="250">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:SurahItem">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Online Resources Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="{Binding Localization.OnlineResourcesTitle}"/>
                    
                    <CheckBox Content="{Binding Localization.GetAudioFromInternetLabel}"
                              IsChecked="{Binding UseRemoteAudio}"
                              Margin="0,0,0,10"/>
                    
                    <!-- Reciter Selection (visible when remote audio is enabled) -->
                    <StackPanel Orientation="Horizontal" 
                                IsVisible="{Binding IsReciterSelectionVisible}"
                                Margin="20,0,0,10">
                        <TextBlock Classes="label" Text="{Binding Localization.SelectReciterLabel}" Width="130"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding ReciterOptions}"
                                  SelectedItem="{Binding SelectedReciter}"
                                  MinWidth="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:ReciterOption" x:CompileBindings="False">
                                    <TextBlock Text="{Binding $parent[Window].DataContext.Localization[DisplayKey]}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <CheckBox Content="{Binding Localization.GetImagesFromInternetLabel}"
                              IsChecked="{Binding UseRemoteImages}"/>
                    
                    <TextBlock Text="{Binding Localization.OnlineResourcesNoteText}"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="#666666"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Display Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="{Binding Localization[DisplaySettingsTitle]}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="{Binding Localization[FontSizeLabel]}" Width="150"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding FontSizeOptions}"
                                  SelectedItem="{Binding FontSize}"
                                  MinWidth="100"/>
                        <TextBlock Text="pt" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="{Binding Localization[QuranTextLabel]}" Width="150"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding QuranTextOptions}"
                                  SelectedItem="{Binding SelectedQuranText}"
                                  MinWidth="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:QuranTextOption" x:CompileBindings="False">
                                    <TextBlock Text="{Binding $parent[Window].DataContext.Localization[DisplayKey]}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0">
                <Button Classes="primary"
                        Content="{Binding Localization.SaveSettingsButton}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,15,0"/>
                
                <Button Classes="secondary"
                        Content="{Binding Localization.CancelButton}"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
