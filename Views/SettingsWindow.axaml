<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuranSearchApp.ViewModels"
        xmlns:services="using:QuranSearch.Core.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        x:Class="QuranSearchApp.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="⚙️ Settings"
        Width="600" Height="550"
        Background="#F5F5DC"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2C5F2D"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        
        <Style Selector="ComboBox.settings-combo">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C5F2D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
        
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#2C5F2D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#2C5F2D"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2C5F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#3A7A3C"/>
        </Style>
        
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#8B7355"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#A68968"/>
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Language Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="🗣️ Language Settings"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="Select Language:" Width="150"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="services:LanguageOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search Domain Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="🔍 Search Domain"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Classes="label" Text="Search In:" Width="150"/>
                        <ComboBox Classes="settings-combo"
                                  ItemsSource="{Binding SearchDomainOptions}"
                                  SelectedItem="{Binding SelectedSearchDomain}"
                                  x:Name="SearchDomainComboBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:SearchDomainOption" x:CompileBindings="False">
                                    <TextBlock Text="{Binding $parent[Window].DataContext.Localization[DisplayKey]}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Single Surah Selection -->
                    <StackPanel IsVisible="{Binding IsSingleSurahSelected}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Surah Number:" Width="150"/>
                            <NumericUpDown Value="{Binding StartSurah}"
                                          Minimum="1"
                                          Maximum="114"
                                          Increment="1"
                                          FormatString="0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Surah Range Selection -->
                    <StackPanel IsVisible="{Binding IsSurahRangeSelected}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Classes="label" Text="From Surah:" Width="150"/>
                            <NumericUpDown Value="{Binding StartSurah}"
                                          Minimum="1"
                                          Maximum="114"
                                          Increment="1"
                                          FormatString="0"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="To Surah:" Width="150"/>
                            <NumericUpDown Value="{Binding EndSurah}"
                                          Minimum="1"
                                          Maximum="114"
                                          Increment="1"
                                          FormatString="0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Online Resources Settings -->
            <Border Classes="settings-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="🌐 Online Resources"/>
                    
                    <CheckBox Content="🔊 Get Audio Files from Internet"
                              IsChecked="{Binding UseRemoteAudio}"
                              Margin="0,0,0,10"/>
                    
                    <CheckBox Content="📷 Get Aya Images from Internet"
                              IsChecked="{Binding UseRemoteImages}"/>
                    
                    <TextBlock Text="Note: Enable these options if local files are not available"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="#666666"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0">
                <Button Classes="primary"
                        Content="💾 Save Settings"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,15,0"/>
                
                <Button Classes="secondary"
                        Content="❌ Cancel"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
