<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kuttab.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="600"
        x:Class="Kuttab.Views.InfoWindow"
        x:DataType="vm:InfoViewModel"
        Title="{Binding Localization.InfoTitle}"
        Width="650" Height="600"
        Background="#F5F5DC"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:InfoViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2C5F2D"/>
        <SolidColorBrush x:Key="LinkColor" Color="#1565C0"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        
        <Style Selector="Border.info-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style Selector="TextBlock.resource-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style Selector="TextBlock.resource-description">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style Selector="TextBlock.link">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkColor}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2C5F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#3A7A3C"/>
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- App Title and Version -->
            <Border Classes="info-card">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📖 القرآن الكريم" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Localization.AppSubtitle}" 
                               FontSize="16" 
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AppVersion}" 
                               FontSize="14" 
                               Foreground="#888888"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Citations & Sources -->
            <Border Classes="info-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="📖 Citations &amp; Sources"/>
                    
                    <!-- Quran Text Citation -->
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📜 " FontSize="16"/>
                                <TextBlock Classes="resource-title" Text="Quran Uthmani Text"/>
                            </StackPanel>
                            <TextBlock Classes="resource-description" Text="This application uses a modified version of the Quran Uthmani text. The original text is sourced from Tanzil.net, which provides a reliable and standardized version of the Holy Quran in Uthmani script."/>
                            <TextBlock Classes="link" 
                                       Text="https://tanzil.net/"
                                       PointerPressed="OnLinkClicked"
                                       Tag="https://tanzil.net/"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Audio Files Citation -->
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔊 " FontSize="16"/>
                                <TextBlock Classes="resource-title" Text="Audio Recitations"/>
                            </StackPanel>
                            <TextBlock Classes="resource-description" Text="Audio files are sourced from EveryAyah.com, which provides high-quality Quran recitations by various renowned reciters."/>
                            <TextBlock Classes="link" 
                                       Text="https://www.everyayah.com/"
                                       PointerPressed="OnLinkClicked"
                                       Tag="https://www.everyayah.com/"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Picture Files Citation -->
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🖼️ " FontSize="16"/>
                                <TextBlock Classes="resource-title" Text="Aya Images"/>
                            </StackPanel>
                            <TextBlock Classes="resource-description" Text="Quranic Aya images are generated from the standard Madani Mushaf format, optimized for digital display."/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Usul.ai Citation -->
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔍 " FontSize="16"/>
                                <TextBlock Classes="resource-title" Text="Tajweed Rules Validation"/>
                            </StackPanel>
                            <TextBlock Classes="resource-description" Text="Usul.ai was utilized for validation and development assistance in creating and testing the Tajweed search rules, ensuring accuracy in pattern detection."/>
                            <TextBlock Classes="link" 
                                       Text="https://usul.ai/"
                                       PointerPressed="OnLinkClicked"
                                       Tag="https://usul.ai/"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Disclaimer -->
            <Border Classes="info-card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="⚠️ Important Notice" Foreground="#D32F2F"/>
                    
                    <!-- Training Disclaimer -->
                    <Border Background="#FFF3E0" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚠️ " FontSize="16"/>
                                <TextBlock Classes="resource-title" Text="Educational Purpose Only" Foreground="#E65100"/>
                            </StackPanel>
                            <TextBlock Classes="resource-description" Text="This application is designed for training and educational purposes. It cannot and should not be used as a substitute for learning Tajweed with a qualified Sheikh. Proper Tajweed requires direct guidance from certified teachers." FontSize="13"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- General Disclaimer -->
                    <Border Background="#FFF3E0" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Classes="resource-description" Text="All accomplishments are by the help of Allah SWT. Any errors or mistakes are from us alone. If you find any inaccuracies or have suggestions for improvement, please contact us." FontSize="13" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Contact Information -->
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📧 " FontSize="16"/>
                                <TextBlock Classes="resource-title" Text="Contact Email:"/>
                            </StackPanel>
                            <TextBlock Classes="resource-description" Text="almanar.backup@gmail.com" FontSize="13"/>
                            <TextBlock Classes="resource-description" Text="Subject: Kuttab" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Classes="resource-description" Text="Please include 'Kuttab' in the email subject for proper routing." FontSize="12" Foreground="#666666"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Acknowledgment -->
            <Border Classes="info-card">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Localization.AcknowledgmentText}" 
                               FontSize="14" 
                               FontStyle="Italic"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"
                               FontFamily="Traditional Arabic"/>
                </StackPanel>
            </Border>

            <!-- Close Button -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0">
                <Button Classes="primary"
                        Content="{Binding Localization.CloseButton}"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
