<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kuttab.ViewModels"
        xmlns:views="using:Kuttab.Views"
        xmlns:models="using:Kuttab.Core.Models"
        xmlns:services="using:Kuttab.Core.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Kuttab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Localization.WindowTitle}"
        Width="1280" Height="720"
        Background="{DynamicResource ThemeBackgroundBrush}"
        RequestedThemeVariant="Light"
        FlowDirection="{Binding CurrentFlowDirection}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Modern Islamic Style -->
        <!-- Base text style for all text elements -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        
        <Style Selector="Border.islamic-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2C5F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#3A7A3C"/>
        </Style>
        
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#8B7355"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#A68968"/>
        </Style>
        
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C84B31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#E05A3F"/>
        </Style>
        
        <Style Selector="ComboBox.islamic">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C5F2D"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#2C5F2D"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Styles>

    <!-- Main Container with Islamic Pattern Background -->
    <Grid>
        <Grid.Resources>
            <!-- Define theme colors -->
            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F5F5DC"/>
            <SolidColorBrush x:Key="CardBackground" Color="White"/>
            <SolidColorBrush x:Key="TextColor" Color="#333333"/>
            <SolidColorBrush x:Key="SecondaryTextColor" Color="#555555"/>
        </Grid.Resources>
        
        <Grid.Styles>
            <Style Selector="TextBlock.secondary">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
            </Style>
        </Grid.Styles>
        
        <Grid.Background>
            <SolidColorBrush Color="#F5F5DC"/>
        </Grid.Background>
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Search Controls -->
            <Border Grid.Row="0" Classes="islamic-card" Margin="0,0,0,2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Settings Button (Gear Icon) -->
                        <Button Content="⚙️"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Settings"
                                Background="#8B7355"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,8"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        
                        <!-- Info Button -->
                        <Button Content="ℹ️"
                                Command="{Binding OpenInfoCommand}"
                                ToolTip.Tip="{Binding Localization.OpenInfo}"
                                Background="#1565C0"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,8"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        
                        <!-- Donate Button -->
                        <Button Content="🕌"
                                Command="{Binding OpenDonateCommand}"
                                ToolTip.Tip="{Binding Localization.OpenDonate}"
                                Background="#2C5F2D"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,8"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        
                        <!-- Recitation Mode Button -->
                        <Button Content="{Binding Localization.OpenRecitation}"
                                Command="{Binding OpenRecitationCommand}"
                                ToolTip.Tip="Open Recitation Mode"
                                Background="#2C5F2D"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"/>
                        
                        <!-- Language Selector (kept for quick access) -->
                        <TextBlock Text="{Binding Localization.Language}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2C5F2D"/>
                        <ComboBox Name="LanguageComboBox"
                                  Classes="islamic"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  MinWidth="140"
                                  Margin="0,0,20,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="services:LanguageOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <TextBlock Text="{Binding Localization.SelectTajweedRule}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,12,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2C5F2D"/>
                        <ComboBox Name="RulesComboBox" 
                                  Classes="islamic"
                                  ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule}"
                                  MinWidth="280"
                                  MaxWidth="400"
                                  Margin="0,0,15,0"/>
                        <Button Content="{Binding Localization.Search}" 
                                Classes="primary"
                                Command="{Binding SearchCommand}"
                                Margin="0,0,15,0"/>
                    </StackPanel>

                    <!-- Grouped, expandable Tajweed rules -->
                    <Border Margin="0,4,0,0"
                            Background="#FAFAF8"
                            BorderBrush="#D4C5B0"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TreeView ItemsSource="{Binding RuleGroups}"
                                  SelectedItem="{Binding SelectedRuleItem}">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="vm:RuleGroupNode"
                                                 ItemsSource="{Binding Rules}">
                                    <TextBlock Text="{Binding GroupTitle}" 
                                               FontWeight="SemiBold"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.DataTemplates>
                                <DataTemplate DataType="vm:RuleItemNode">
                                    <TextBlock Text="{Binding RuleTitle}"/>
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Grid.Row="1" 
                    Background="#2C5F2D" 
                    CornerRadius="8"
                    Padding="6,4" 
                    Margin="0,0,0,2">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="13"/>
            </Border>

            <!-- Search Results List -->
            <Border Grid.Row="2" Classes="islamic-card" Margin="0,0,0,2" MaxHeight="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0"
                            Background="#8B7355"
                            CornerRadius="6"
                            Padding="6,3"
                            Margin="0,0,0,4"
                            IsVisible="{Binding HasRuleDescription}">
                        <TextBlock Text="{Binding RuleDescription}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    
                    <Border Grid.Row="1" 
                            Background="#FAFAF8"
                            BorderBrush="#D4C5B0" 
                            BorderThickness="2" 
                            CornerRadius="8">
                        <ListBox Name="ResultsListBox"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedAya}"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:QuranAya" x:CompileBindings="False">
                                    <Border Margin="3" Padding="8" CornerRadius="8"
                                            Background="White"
                                            BorderBrush="#E8DCC4"
                                            BorderThickness="1">
                                        <Border.Styles>
                                            <Style Selector="Border[Tag=True]">
                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                <Setter Property="BorderBrush" Value="#2C5F2D"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BoxShadow" Value="0 2 8 0 #402C5F2D"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border.Tag>
                                            <Binding Path="IsCurrentlyPlaying"/>
                                        </Border.Tag>
                                        <StackPanel>
                                            <!-- Sura and Aya header -->
                                            <Border Background="#F8F4EF" 
                                                    CornerRadius="4" 
                                                    Padding="6,3"
                                                    Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📜 "
                                                               FontSize="13" 
                                                               Foreground="#8B7355" 
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="13" 
                                                               Foreground="#8B7355" 
                                                               FontWeight="SemiBold">
                                                        <Run Text="{Binding SurahNumber}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="("/>
                                                        <Run Text="{Binding SurahName}"/>
                                                        <Run Text=")"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding AyaNumber}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Arabic text with highlighted matches -->
                                            <views:HighlightedTextBlock Text="{Binding Text}"
                                                                        MatchPositions="{Binding MatchPositions}"
                                                                        FontSize="{Binding $parent[Window].DataContext.FontSize}"
                                                                        Margin="0,0,0,4"/>
                                            
                                            <!-- Matched characters display -->
                                            <Border Background="#FFF9F0" 
                                                    CornerRadius="4" 
                                                    Padding="6,3"
                                                    Margin="0,0,0,0"
                                                    FlowDirection="{Binding $parent[Window].DataContext.CurrentFlowDirection}">
                                                <TextBlock FontSize="12" 
                                                           Foreground="#B8860B"
                                                           FontWeight="Medium"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding $parent[Window].DataContext.Localization.Matched}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding MatchedText}" FontFamily="Traditional Arabic"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- Audio Controls -->
            <Border Grid.Row="3" Classes="islamic-card" Margin="0,0,0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="{Binding Localization.AudioControls}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#2C5F2D"
                               Margin="0,0,0,4"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="{Binding Localization.PlaySingle}" 
                                Classes="secondary"
                                Command="{Binding PlaySingleCommand}"
                                IsEnabled="{Binding !IsPlaying}"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="{Binding Localization.PlayRepeat}" 
                                Classes="secondary"
                                Command="{Binding PlayRepeatCommand}"
                                IsEnabled="{Binding !IsPlaying}"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="{Binding Localization.PlayAllSequence}" 
                                Classes="secondary"
                                Command="{Binding PlayAllCommand}"
                                IsEnabled="{Binding CanStartSequence}"
                                Margin="0,0,10,0"/>
                        
                        <!-- Pause/Resume toggle button -->
                        <Button Content="{Binding PauseResumeButtonText}"
                                Command="{Binding PauseResumeCommand}"
                                IsVisible="{Binding IsSequenceActive}"
                                Background="{Binding PauseResumeButtonColor}"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="16,8"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="{Binding Localization.Stop}" 
                                Classes="danger"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsPlaying}"
                                Margin="0,0,15,0"/>
                        
                        <!-- Playback Status -->
                        <Border Background="#FFF3CD" 
                                BorderBrush="#FFE69C"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsPlaying}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔴" 
                                           FontSize="14"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Localization.Playing}" 
                                           FontWeight="SemiBold"
                                           Foreground="#856404"/>
                                <TextBlock Text="{Binding Localization.Repeat}" 
                                           FontStyle="Italic"
                                           Foreground="#856404"
                                           Margin="6,0,0,0"
                                           IsVisible="{Binding IsRepeating}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#FFF3CD" 
                                BorderBrush="#FFE69C"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                IsVisible="{Binding IsSequencePaused}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸️" 
                                           FontSize="14"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Localization.SequencePaused}" 
                                           FontWeight="SemiBold"
                                           Foreground="#856404"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Picture Display Area -->
            <Border Grid.Row="4" Classes="islamic-card">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="{Binding Localization.QuranicPageView}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#2C5F2D"
                               Margin="0,0,0,8"/>
                    
                    <Border Grid.Row="1" 
                            Background="#FAFAF8"
                            BorderBrush="#D4C5B0"
                            BorderThickness="2"
                            CornerRadius="8"
                            Height="100">
                        <Grid>
                            <TextBlock Text="{Binding Localization.SelectAyaToViewImage}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="#8B7355"
                                       FontStyle="Italic"
                                       FontSize="16"
                                       IsVisible="{Binding CurrentPicturePath, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding CurrentPictureBitmap}" 
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding CurrentPicturePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Bar Removed -->
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
