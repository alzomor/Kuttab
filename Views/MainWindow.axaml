<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuranSearchApp.ViewModels"
        xmlns:views="using:QuranSearchApp.Views"
        xmlns:models="using:QuranSearchApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="QuranSearchApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="القرآن الكريم - Quran Pattern Search"
        Width="1280" Height="720"
        Background="{DynamicResource ThemeBackgroundBrush}"
        RequestedThemeVariant="Light">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Modern Islamic Style -->
        <!-- Base text style for all text elements -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        
        <Style Selector="Border.islamic-card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2C5F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#3A7A3C"/>
        </Style>
        
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#8B7355"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#A68968"/>
        </Style>
        
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C84B31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#E05A3F"/>
        </Style>
        
        <Style Selector="ComboBox.islamic">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C5F2D"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#2C5F2D"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Styles>

    <!-- Main Container with Islamic Pattern Background -->
    <Grid>
        <Grid.Resources>
            <!-- Define theme colors -->
            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F5F5DC"/>
            <SolidColorBrush x:Key="CardBackground" Color="White"/>
            <SolidColorBrush x:Key="TextColor" Color="#333333"/>
            <SolidColorBrush x:Key="SecondaryTextColor" Color="#555555"/>
        </Grid.Resources>
        
        <Grid.Styles>
            <Style Selector="TextBlock.secondary">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
            </Style>
        </Grid.Styles>
        
        <Grid.Background>
            <SolidColorBrush Color="#F5F5DC"/>
        </Grid.Background>
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="10" MinWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Islamic Design -->
            <Border Grid.Row="0" Classes="islamic-card" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#2C5F2D"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Quran Tajweed Pattern Search" 
                                   FontSize="15" 
                                   FontWeight="SemiBold"
                                   Foreground="#8B7355"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>
                        <Border Background="#FFE69C" 
                                BorderBrush="#FFC107"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="10,4"
                                HorizontalAlignment="Center">
                            <TextBlock Text="🔬 نسخة تجريبية v0.3 - TEST VERSION" 
                                       FontSize="13" 
                                       FontWeight="Bold"
                                       Foreground="#856404"/>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="🌐 Online Images" 
                                  IsChecked="{Binding UseRemoteImages}"
                                  Margin="0,0,15,0"/>
                        <CheckBox Content="🔊 Online Audio" 
                                  IsChecked="{Binding UseRemoteAudio}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Search Controls -->
            <Border Grid.Row="1" Classes="islamic-card" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📖 Select Tajweed Rule:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C5F2D"/>
                    <ComboBox Name="RulesComboBox" 
                              Classes="islamic"
                              ItemsSource="{Binding Rules}"
                              SelectedItem="{Binding SelectedRule}"
                              Width="280" 
                              Margin="0,0,15,0"/>
                    <Button Content="🔍 Search" 
                            Classes="primary"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Grid.Row="2" 
                    Background="#2C5F2D" 
                    CornerRadius="8"
                    Padding="6,4" 
                    Margin="0,0,0,6">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="13"/>
            </Border>

            <!-- Search Results List -->
            <Border Grid.Row="3" Classes="islamic-card" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0"
                            Background="#8B7355"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,8"
                            IsVisible="{Binding HasRuleDescription}">
                        <TextBlock Text="{Binding RuleDescription}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    
                    <Border Grid.Row="1" 
                            Background="#FAFAF8"
                            BorderBrush="#D4C5B0" 
                            BorderThickness="2" 
                            CornerRadius="8">
                        <ListBox Name="ResultsListBox"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedAya}"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:QuranAya">
                                    <Border Margin="6" Padding="12" CornerRadius="8"
                                            Background="White"
                                            BorderBrush="#E8DCC4"
                                            BorderThickness="1">
                                        <Border.Styles>
                                            <Style Selector="Border[Tag=True]">
                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                <Setter Property="BorderBrush" Value="#2C5F2D"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BoxShadow" Value="0 2 8 0 #402C5F2D"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border.Tag>
                                            <Binding Path="IsCurrentlyPlaying"/>
                                        </Border.Tag>
                                        <StackPanel>
                                            <!-- Sura and Aya header -->
                                            <Border Background="#F8F4EF" 
                                                    CornerRadius="4" 
                                                    Padding="8,4"
                                                    Margin="0,0,0,8">
                                                <TextBlock FontSize="13" 
                                                           Foreground="#8B7355" 
                                                           FontWeight="SemiBold">
                                                    <Run Text="📜 سورة "/>
                                                    <Run Text="{Binding SurahNumber}"/>
                                                    <Run Text=" - آية "/>
                                                    <Run Text="{Binding AyaNumber}"/>
                                                </TextBlock>
                                            </Border>
                                            
                                            <!-- Arabic text with highlighted matches -->
                                            <views:HighlightedTextBlock Text="{Binding Text}"
                                                                        MatchPositions="{Binding MatchPositions}"
                                                                        Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- Audio Controls -->
            <Border Grid.Row="4" Classes="islamic-card" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="Audio Controls" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#2C5F2D"
                               Margin="0,0,0,8"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="▶️ Play Single" 
                                Classes="secondary"
                                Command="{Binding PlaySingleCommand}"
                                IsEnabled="{Binding !IsPlaying}"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="🔁 Play Repeat" 
                                Classes="secondary"
                                Command="{Binding PlayRepeatCommand}"
                                IsEnabled="{Binding !IsPlaying}"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="📋 Play All Sequence" 
                                Classes="secondary"
                                Command="{Binding PlayAllCommand}"
                                IsEnabled="{Binding CanStartSequence}"
                                Margin="0,0,10,0"/>
                        
                        <!-- Pause/Resume toggle button -->
                        <Button Content="{Binding PauseResumeButtonText}"
                                Command="{Binding PauseResumeCommand}"
                                IsVisible="{Binding IsSequenceActive}"
                                Background="{Binding PauseResumeButtonColor}"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="16,8"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="⏹️ Stop" 
                                Classes="danger"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsPlaying}"
                                Margin="0,0,15,0"/>
                        
                        <!-- Playback Status -->
                        <Border Background="#FFF3CD" 
                                BorderBrush="#FFE69C"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsPlaying}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔴" 
                                           FontSize="14"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Playing" 
                                           FontWeight="SemiBold"
                                           Foreground="#856404"/>
                                <TextBlock Text="(Repeat)" 
                                           FontStyle="Italic"
                                           Foreground="#856404"
                                           Margin="6,0,0,0"
                                           IsVisible="{Binding IsRepeating}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#FFF3CD" 
                                BorderBrush="#FFE69C"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                IsVisible="{Binding IsSequencePaused}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸️" 
                                           FontSize="14"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Sequence Paused" 
                                           FontWeight="SemiBold"
                                           Foreground="#856404"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Picture Display Area -->
            <Border Grid.Row="5" Classes="islamic-card">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="📷 Quranic Page View" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#2C5F2D"
                               Margin="0,0,0,8"/>
                    
                    <Border Grid.Row="1" 
                            Background="#FAFAF8"
                            BorderBrush="#D4C5B0"
                            BorderThickness="2"
                            CornerRadius="8"
                            Height="100">
                        <Grid>
                            <TextBlock Text="اختر آية لعرض صورتها 📖" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="#8B7355"
                                       FontStyle="Italic"
                                       FontSize="16"
                                       IsVisible="{Binding CurrentPicturePath, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding CurrentPictureBitmap}" 
                                   Stretch="Uniform"
                                   MaxHeight="100"
                                   MaxWidth="1240"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding CurrentPicturePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Bar Removed -->
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
