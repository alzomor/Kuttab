<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuranSearchApp.ViewModels"
        xmlns:views="using:QuranSearchApp.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="QuranSearchApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Quran Pattern Search"
        Width="1000" Height="700">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Search Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Select Rule:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Name="RulesComboBox" 
                      ItemsSource="{Binding Rules}"
                      SelectedItem="{Binding SelectedRule}"
                      Width="200" Margin="0,0,10,0"/>
            <Button Content="Search" 
                    Command="{Binding SearchCommand}"
                    Padding="15,5" Margin="0,0,20,0"/>
            
            <TextBlock Text="Font Size:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Slider Value="{Binding FontSize}" 
                    Minimum="12" Maximum="32" 
                    Width="100" 
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>
            <TextBlock Text="{Binding FontSize, StringFormat=F0}" 
                       VerticalAlignment="Center" 
                       Width="25"/>
        </StackPanel>

        <!-- Results Count -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding StatusMessage}" 
                   Margin="0,0,0,10"
                   FontWeight="Bold"/>

        <!-- Search Results List -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0"
                       Text="{Binding RuleDescription}" 
                       FontSize="14" 
                       FontWeight="Bold"
                       Foreground="DarkBlue"
                       Margin="0,0,0,5"
                       IsVisible="{Binding HasRuleDescription}"/>
            
            <Border Grid.Row="1" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    Margin="0,0,0,10">
                <ListBox Name="ResultsListBox"
                         ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedAya}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <!-- Sura and Aya on same line -->
                            <TextBlock FontSize="16" Foreground="Gray" Margin="0,0,0,5">
                                <Run Text="Surah "/>
                                <Run Text="{Binding SurahNumber}"/>
                                <Run Text=" - Aya "/>
                                <Run Text="{Binding AyaNumber}"/>
                            </TextBlock>
                            
                            <!-- Arabic text with highlighted matches -->
                            <views:HighlightedTextBlock Text="{Binding Text}"
                                                        MatchPositions="{Binding MatchPositions}"
                                                        Margin="0,0,0,8"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Audio Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Play Single" 
                    Command="{Binding PlaySingleCommand}"
                    Margin="0,0,10,0" Padding="10,5"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="Repeat:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <NumericUpDown Value="{Binding RepeatCount}" 
                               Minimum="1" Maximum="100" 
                               Width="60" Margin="0,0,5,0"/>
                <Button Content="Play Repeat" 
                        Command="{Binding PlayRepeatCommand}"
                        Padding="10,5"/>
            </StackPanel>
            
            <Button Content="Play All Sequence" 
                    Command="{Binding PlayAllCommand}"
                    Padding="10,5"/>
        </StackPanel>

        <!-- Picture Display Area -->
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1">
            <Grid>
                <TextBlock Text="Picture will be displayed here for selected Aya" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           FontStyle="Italic"/>
                <Image Name="AyaPictureBox" 
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="LightGray" Padding="5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
