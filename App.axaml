<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuranSearchApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Scheherazade, Noto Sans Arabic, DejaVu Sans, sans-serif"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Avalonia.Themes.Fluent/FluentLight.axaml"/>
                <ResourceInclude Source="avares://Avalonia.Themes.Fluent/FluentLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Embedded Fonts -->
            <FontFamily x:Key="DefaultFontFamily">resm:QuranSearchApp.Fonts.NotoSansArabic-Regular.ttf?assembly=QuranSearchApp#Noto Sans Arabic</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
