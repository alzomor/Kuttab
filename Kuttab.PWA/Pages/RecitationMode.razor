@page "/recitation"
@implements IDisposable
@inject QuranSearchService SearchService
@inject LocalizationService Loc
@inject LocalStorageService Storage
@inject IJSRuntime JS
@inject IFileService FileService
@using Kuttab.Core.Interfaces
@using Kuttab.Core.Services

<PageTitle>Kuttab - @Loc["RecitationMode"]</PageTitle>

<div class="card-panel">
    <h5 style="color: var(--kuttab-green); font-weight: 700;">@Loc["RecitationMode"]</h5>

    <div class="mb-2">
        <label class="form-label">@Loc["SelectReciter"]</label>
        <select class="form-select" @bind="_selectedReciter">
            @foreach (var r in _reciters)
            {
                <option value="@r.Id">@Loc[r.DisplayKey]</option>
            }
        </select>
    </div>

    <div class="mb-2">
        <label class="form-label">@Loc["Surah"]</label>
        <select class="form-select" @onchange="OnSurahChanged">
            @for (int s = 1; s <= 114; s++)
            {
                var sNum = s;
                <option value="@sNum" selected="@(sNum == _selectedSurah)">@sNum - @SurahInfo.GetSurahName(sNum)</option>
            }
        </select>
    </div>

    <div class="row mb-2">
        <div class="col-6">
            <label class="form-label">@Loc["FromAya"]</label>
            <input type="number" class="form-control" min="1" max="@_maxAya" @bind="_fromAya" />
        </div>
        <div class="col-6">
            <label class="form-label">@Loc["ToAya"]</label>
            <input type="number" class="form-control" min="1" max="@_maxAya" @bind="_toAya" />
        </div>
    </div>

    <div class="row mb-2">
        <div class="col-6">
            <label class="form-label">@Loc["RepeatCount"]</label>
            <input type="number" class="form-control" min="1" max="99" @bind="_repeatCount" />
        </div>
        <div class="col-6">
            <label class="form-label">@Loc["RepeatMode"]</label>
            <select class="form-select" @bind="_repeatMode">
                <option value="aya">@Loc["RepeatAya"]</option>
                <option value="range">@Loc["RepeatRange"]</option>
            </select>
        </div>
    </div>

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="teacherMode" @bind="_teacherMode" />
        <label class="form-check-label" for="teacherMode">@Loc["TeacherMode"]</label>
    </div>
    
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="showTajweedRules" @bind="_showTajweedRules" />
        <label class="form-check-label" for="showTajweedRules">@Loc["ShowTajweedRules"]</label>
    </div>
</div>

@if (!string.IsNullOrEmpty(_currentAyaText))
{
    <div class="card-panel">
        <div class="text-center mb-1" style="font-size: 0.85rem; color: var(--kuttab-green); font-weight: 600;">
            @_currentAyaInfo
        </div>
        <div class="quran-text" dir="rtl" style="text-align: center;">
            @((MarkupString)_highlightedAyaText)
        </div>
        @if (_useOnlineImages && _currentPageNumber > 0)
        {
            <div class="text-center mt-2">
                <img src="https://everyayah.com/data/quranpages/@(_currentPageNumber.ToString("D3")).png"
                     alt="Quran page @_currentPageNumber"
                     style="max-width: 100%; border-radius: 4px; border: 1px solid #e0e0e0;"
                     loading="lazy" />
                <div style="font-size: 0.75rem; color: var(--kuttab-text-light); margin-top: 0.25rem;">@Loc["Page"] @_currentPageNumber</div>
            </div>
        }
    </div>
}

<div class="controls-fixed">
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        @if (!_isPlaying)
        {
            <button class="btn-kuttab" @onclick="StartPlayback">@Loc["Play"]</button>
        }
        else
        {
            <button class="btn-kuttab" style="background: #C62828;" @onclick="StopPlayback">@Loc["Stop"]</button>
        }
    </div>
    <div class="text-center mt-1" style="font-size: 0.85rem; color: var(--kuttab-text-light);">
        @_statusText
    </div>
</div>

@if (_showTajweedRules && _tajweedMatches.Count > 0)
{
    <div class="card-panel">
        <h6 style="color: var(--kuttab-green-dark); font-weight: 700;">@Loc["TajweedRules"]</h6>
        @foreach (var match in _tajweedMatches)
        {
            var explanation = TajweedRulesExplanation.GetExplanation(match.RuleName, Loc.CurrentLanguage);
            <div class="mb-2" style="font-size: 0.85rem;">
                <div class="mb-1">
                    <span class="tajweed-@match.GroupName" style="font-weight: 700;">@(RuleNameTranslator.GetLocalizedName(match.RuleName, Loc.CurrentLanguage))</span>
                    <span style="color: var(--kuttab-text-light);"> — @match.MatchedText</span>
                </div>
                @if (!string.IsNullOrEmpty(explanation))
                {
                    <div class="ms-3" style="color: var(--kuttab-text-light); font-size: 0.8rem; line-height: 1.4;">
                        @(explanation.Replace("\n", "<br/>"))
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private int _selectedSurah = 1;
    private int _fromAya = 1;
    private int _toAya = 7;
    private int _maxAya = 7;
    private int _repeatCount = 1;
    private string _repeatMode = "aya";
    private bool _teacherMode;
    private bool _showTajweedRules = true;
    private string _selectedReciter = "Husary_128kbps";

    private bool _isPlaying;
    private string _statusText = "";
    private string _currentAyaInfo = "";
    private string _currentAyaText = "";
    private string _highlightedAyaText = "";
    private int _currentPlayIdx;
    private int _currentRepeat;
    private List<TajweedRuleMatch> _tajweedMatches = new();
    private DotNetObjectReference<RecitationMode>? _dotNetRef;
    private bool _useOnlineImages = true;
    private List<string>? _selectedTajweedRules = null; // null = all rules
    private int _currentPageNumber = 0;
    private bool _needsBasmalah = false;
    private bool _playingBasmalah = false;
    private QuranPageService _pageService = new();

    private Dictionary<string, string> _quranTextCache = new();

    private List<ReciterOption> _reciters = new()
    {
        new() { Id = "Abdul_Basit_Murattal_192kbps", DisplayKey = "ReciterAbdulBasit" },
        new() { Id = "Ayman_Sowaid_64kbps", DisplayKey = "ReciterAymanSowaid" },
        new() { Id = "Husary_128kbps", DisplayKey = "ReciterHusary" },
        new() { Id = "Husary_Muallim_128kbps", DisplayKey = "ReciterHusaryMuallim" },
        new() { Id = "Menshawi_32kbps", DisplayKey = "ReciterMenshawi" },
        new() { Id = "Mohammad_al_Tablaway_128kbps", DisplayKey = "ReciterTablaway" },
        new() { Id = "Mustafa_Ismail_48kbps", DisplayKey = "ReciterMustafaIsmail" },
        new() { Id = "Muhammad_Ayyoub_128kbps", DisplayKey = "ReciterAyyoub" },
        new() { Id = "mahmoud_ali_al_banna_32kbps", DisplayKey = "ReciterBanna" },
    };

    private class ReciterOption { public string Id { get; set; } = ""; public string DisplayKey { get; set; } = ""; }

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLocLanguageChanged;
        await SearchService.LoadQuranTextAsync();
        await SearchService.LoadRulesAsync();

        var content = await FileService.ReadAllTextAsync("quran-uthmani-ver1.2.txt");
        foreach (var line in content.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = line.Split('|');
            if (parts.Length >= 3)
                _quranTextCache[$"{parts[0]}|{parts[1]}"] = parts[2].Trim();
        }

        _maxAya = SurahInfo.GetAyaCount(_selectedSurah);
        _toAya = _maxAya;
        _statusText = Loc["Ready"];

        // Load settings
        _useOnlineImages = (await Storage.GetStringAsync("onlineImages")) != "false";
        _showTajweedRules = (await Storage.GetStringAsync("showTajweedRules")) != "false";
        var savedRulesJson = await Storage.GetStringAsync("selectedTajweedRules");
        if (!string.IsNullOrEmpty(savedRulesJson))
        {
            try
            {
                var set = System.Text.Json.JsonSerializer.Deserialize<HashSet<string>>(savedRulesJson);
                if (set != null && set.Count > 0)
                    _selectedTajweedRules = set.ToList();
            }
            catch { }
        }

        // Load quran-data.xml for page mapping
        try
        {
            var xmlContent = await FileService.ReadAllTextAsync("quran-data.xml");
            _pageService.LoadFromXml(xmlContent);
        }
        catch { }
    }

    private void OnSurahChanged(ChangeEventArgs e)
    {
        _selectedSurah = int.Parse(e.Value?.ToString() ?? "1");
        _maxAya = SurahInfo.GetAyaCount(_selectedSurah);
        _fromAya = 1;
        _toAya = _maxAya;
    }

    private async Task StartPlayback()
    {
        _isPlaying = true;
        _currentPlayIdx = _fromAya;
        _currentRepeat = 1;
        _needsBasmalah = ShouldPlayBasmalah(_selectedSurah, _fromAya);
        _playingBasmalah = false;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("AudioInterop.init", _dotNetRef);
        await PlayCurrentAya();
    }

    private bool ShouldPlayBasmalah(int surah, int aya)
    {
        if (aya != 1) return false;
        if (surah == 1 || surah == 9) return false;
        // Reciters whose audio already includes Basmalah
        if (_selectedReciter == "Menshawi_32kbps" ||
            _selectedReciter == "Mustafa_Ismail_48kbps")
            return false;
        // Al-Banna includes Basmalah except for Surah 108
        if (_selectedReciter == "mahmoud_ali_al_banna_32kbps")
            return surah == 108;
        return true;
    }

    private async Task PlayCurrentAya()
    {
        if (!_isPlaying)
        {
            StateHasChanged();
            return;
        }

        // Play Basmalah before the first aya of a surah when required
        if (_needsBasmalah && !_playingBasmalah)
        {
            _playingBasmalah = true;
            _currentAyaInfo = "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ";
            _currentAyaText = "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ";
            _highlightedAyaText = System.Net.WebUtility.HtmlEncode(_currentAyaText);
            _tajweedMatches = new();
            _statusText = Loc["Playing"];
            StateHasChanged();
            var basmalahUrl = GetAudioUrl(1, 1);
            await JS.InvokeVoidAsync("AudioInterop.play", basmalahUrl);
            return;
        }

        if (_currentPlayIdx > _toAya)
        {
            if (_repeatMode == "range" && _currentRepeat < _repeatCount)
            {
                _currentRepeat++;
                _currentPlayIdx = _fromAya;
                _needsBasmalah = ShouldPlayBasmalah(_selectedSurah, _fromAya);
                _playingBasmalah = false;
                await PlayCurrentAya();
                return;
            }
            _isPlaying = false;
            _statusText = Loc["Ready"];
            _currentPageNumber = 0;
            StateHasChanged();
            return;
        }

        var key = $"{_selectedSurah}|{_currentPlayIdx}";
        var text = _quranTextCache.GetValueOrDefault(key, "");
        _currentAyaInfo = $"{Loc["Surah"]} {_selectedSurah} - {Loc["Aya"]} {_currentPlayIdx}";
        _currentAyaText = text;
        _highlightedAyaText = HighlightAyaWithTajweed(text);

        // Get tajweed matches using selected rules filter
        _tajweedMatches = SearchService.SearchAyaForRules(text, _selectedTajweedRules);

        // Update page number for image display
        _currentPageNumber = _pageService.IsLoaded ? _pageService.GetPageForAya(_selectedSurah, _currentPlayIdx) : 0;

        var repeatSuffix = _repeatMode == "aya" && _repeatCount > 1
            ? $" ({_currentRepeat}/{_repeatCount})"
            : "";
        _statusText = Loc.GetString("PlayingAya", _selectedSurah, _currentPlayIdx) + repeatSuffix;

        StateHasChanged();

        var url = GetAudioUrl(_selectedSurah, _currentPlayIdx);
        await JS.InvokeVoidAsync("AudioInterop.play", url);
    }

    [JSInvokable]
    public async Task OnPlaybackEnded()
    {
        if (!_isPlaying) return;

        // If we just played the Basmalah, now play the actual aya
        if (_playingBasmalah)
        {
            _playingBasmalah = false;
            _needsBasmalah = false;
            await PlayCurrentAya();
            return;
        }

        if (_repeatMode == "aya" && _currentRepeat < _repeatCount)
        {
            _currentRepeat++;
            await PlayCurrentAya();
            return;
        }

        _currentRepeat = 1;

        if (_teacherMode)
        {
            _statusText = Loc["TeacherModePause"];
            StateHasChanged();
            await Task.Delay(3000);
        }

        _currentPlayIdx++;
        // Check if next aya starts a new surah (would need basmalah)
        _needsBasmalah = _currentPlayIdx <= _toAya && ShouldPlayBasmalah(_selectedSurah, _currentPlayIdx);
        _playingBasmalah = false;
        await PlayCurrentAya();
    }

    [JSInvokable]
    public void OnPlaybackError(string error)
    {
        _statusText = $"Error: {error}";
        _isPlaying = false;
        StateHasChanged();
    }

    private async Task StopPlayback()
    {
        _isPlaying = false;
        await JS.InvokeVoidAsync("AudioInterop.stop");
        _statusText = Loc["Ready"];
    }

    private string HighlightAyaWithTajweed(string ayaText)
    {
        if (string.IsNullOrEmpty(ayaText)) return "";
        var matches = SearchService.SearchAyaForRules(ayaText, _selectedTajweedRules);
        if (matches.Count == 0)
            return System.Net.WebUtility.HtmlEncode(ayaText);

        // Implement Android-style ZWJ handling for proper Arabic connections
        const char ZWJ = '\u200D';
        var textBuilder = new System.Text.StringBuilder(ayaText);
        var sortedMatches = matches.OrderBy(m => m.MatchStart).ToList();
        
        // Helper functions from Android
        bool IsArabicLetter(char c) => (c >= '\u0621' && c <= '\u064A') || c == '\u0671';
        bool IsDiacritic(char c) => (c >= '\u064B' && c <= '\u0652') || (c >= '\u0670' && c <= '\u0670');
        bool IsConnector(char c) => IsArabicLetter(c) && 
            c != '\u0627' && c != '\u0622' && c != '\u0623' && c != '\u0625' && c != '\u0671' &&
            c != '\u062F' && c != '\u0630' && c != '\u0631' && c != '\u0632' && c != '\u0648' && c != '\u0621';
        bool CanReceiveFromRight(char c) => IsArabicLetter(c) && c != '\u0621';
        
        int FindPrevBaseIndex(string s, int start)
        {
            int i = start;
            while (i >= 0 && (IsDiacritic(s[i]) || s[i] == ZWJ)) i--;
            return i;
        }
        
        int FindNextBaseIndex(string s, int start)
        {
            int i = start;
            while (i < s.Length && (IsDiacritic(s[i]) || s[i] == ZWJ)) i++;
            return i < s.Length ? i : -1;
        }

        // Process each match to add ZWJs where needed
        int offsetAdjustment = 0;
        for (int matchIndex = 0; matchIndex < sortedMatches.Count; matchIndex++)
        {
            var match = sortedMatches[matchIndex];
            int adjustedStart = match.MatchStart + offsetAdjustment;
            int adjustedLength = match.MatchLength;
            var added = 0;

            var prevIndex = FindPrevBaseIndex(textBuilder.ToString(), adjustedStart - 1);
            var nextIndex = FindNextBaseIndex(textBuilder.ToString(), adjustedStart + adjustedLength);

            char firstChar = adjustedStart < textBuilder.Length ? textBuilder[adjustedStart] : '\0';
            char lastChar = (adjustedStart + adjustedLength - 1) < textBuilder.Length && adjustedLength > 0
                ? textBuilder[adjustedStart + adjustedLength - 1] : '\0';

            bool connectPrevToFirst = prevIndex >= 0 && IsConnector(textBuilder[prevIndex]) && IsConnector(firstChar);
            bool connectLastToNext = nextIndex >= 0 && IsConnector(lastChar) && CanReceiveFromRight(textBuilder[nextIndex]);

            // BEFORE boundary: external ZWJ after previous cluster, internal ZWJ at start of match
            if (connectPrevToFirst)
            {
                // External ZWJ after previous cluster
                int extPos = prevIndex + 1;
                while (extPos < textBuilder.Length && IsDiacritic(textBuilder[extPos])) extPos++;
                
                if (extPos >= 0 && !(extPos < textBuilder.Length && textBuilder[extPos] == ZWJ))
                {
                    textBuilder.Insert(extPos, ZWJ);
                    if (extPos <= adjustedStart) adjustedStart++;
                    added++;
                }

                // Internal ZWJ at the very start of the match
                if (!(adjustedStart < textBuilder.Length && textBuilder[adjustedStart] == ZWJ))
                {
                    textBuilder.Insert(adjustedStart, ZWJ);
                    added++;
                }
            }

            // AFTER boundary: internal ZWJ right after last base, external ZWJ after trailing diacritics
            if (connectLastToNext)
            {
                // Internal ZWJ immediately after the last base (before its diacritics)
                int intAfterPos = adjustedStart + adjustedLength + (connectPrevToFirst ? 1 : 0);
                if (!(intAfterPos < textBuilder.Length && textBuilder[intAfterPos] == ZWJ))
                {
                    textBuilder.Insert(intAfterPos, ZWJ);
                    added++;
                }

                // External ZWJ after last base + its diacritics (between clusters)
                int extAfterPos = adjustedStart + adjustedLength + added;
                while (extAfterPos < textBuilder.Length && IsDiacritic(textBuilder[extAfterPos])) extAfterPos++;
                
                if (!(extAfterPos < textBuilder.Length && textBuilder[extAfterPos] == ZWJ))
                {
                    textBuilder.Insert(extAfterPos, ZWJ);
                    added++;
                }
            }

            offsetAdjustment += added;
        }

        var adjustedText = textBuilder.ToString();
        var sb = new System.Text.StringBuilder();
        int lastEnd = 0;
        
        // Apply highlighting with ZWJ-aware positions
        foreach (var match in sortedMatches)
        {
            // Find the adjusted position accounting for ZWJs inserted before this match
            int originalPos = 0;
            int adjustedStart = 0;
            
            for (int i = 0; i < adjustedText.Length; i++)
            {
                if (originalPos == match.MatchStart)
                {
                    adjustedStart = i;
                    // Skip ZWJs to find actual content start
                    while (adjustedStart < adjustedText.Length && adjustedText[adjustedStart] == ZWJ)
                        adjustedStart++;
                    break;
                }
                if (adjustedText[i] != ZWJ)
                    originalPos++;
            }
            
            if (adjustedStart < lastEnd) continue;
            if (adjustedStart > lastEnd)
                sb.Append(System.Net.WebUtility.HtmlEncode(adjustedText.Substring(lastEnd, adjustedStart - lastEnd)));
            
            // Find the end of the match, excluding trailing ZWJs
            int adjustedEnd = adjustedStart;
            int charsToConsume = match.MatchLength;
            while (charsToConsume > 0 && adjustedEnd < adjustedText.Length)
            {
                if (adjustedText[adjustedEnd] != ZWJ)
                    charsToConsume--;
                if (charsToConsume > 0) // Don't advance past the last character
                    adjustedEnd++;
            }
            
            var matchText = adjustedText.Substring(adjustedStart, adjustedEnd - adjustedStart);
            sb.Append($"<span class=\"tajweed-{match.GroupName} tajweed-highlight-{match.GroupName}\">");
            sb.Append(System.Net.WebUtility.HtmlEncode(matchText));
            sb.Append("</span>");
            lastEnd = adjustedEnd;
        }
        
        if (lastEnd < adjustedText.Length)
            sb.Append(System.Net.WebUtility.HtmlEncode(adjustedText.Substring(lastEnd)));
        
        return sb.ToString();
    }

    private string GetAudioUrl(int surah, int aya)
    {
        return $"https://everyayah.com/data/{_selectedReciter}/{surah:D3}{aya:D3}.mp3";
    }

    private void OnLocLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLocLanguageChanged;
    }
}
