@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService Loc
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="app-container @(_isMenuOpen ? "menu-open" : "menu-closed")">
    <!-- Menu Toggle Button - Fixed position, visible when menu is closed -->
    <button class="menu-toggle-btn" @onclick="ToggleMenu" title="@Loc.GetString("Menu")">
        <span class="menu-icon">☰</span>
    </button>
    
    <!-- Overlay for mobile - closes menu when clicked -->
    <div class="menu-overlay @(_isMenuOpen ? "visible" : "")" @onclick="CloseMenu"></div>
    
    <nav class="nav-side @(_isMenuOpen ? "open" : "closed")">
        <div class="nav-header">
            <button class="nav-close-btn" @onclick="CloseMenu" title="@Loc.GetString("Close")">✕</button>
            <h1>كُتّاب - Kuttab</h1>
        </div>
        <div class="nav-links">
            <NavLink href="" Match="NavLinkMatch.All">
                <span class="nav-icon">📖</span>
                <span>@Loc.GetString("SingleRuleTraining")</span>
            </NavLink>
            <NavLink href="hifz">
                <span class="nav-icon">🧠</span>
                <span>@Loc.GetString("HifzMode") <small style="opacity:0.7; font-size:0.7em;">(@Loc.GetString("Experimental"))</small></span>
            </NavLink>
            <NavLink href="recitation">
                <span class="nav-icon">🎧</span>
                <span>@Loc.GetString("RecitationMode")</span>
            </NavLink>
            <NavLink href="settings">
                <span class="nav-icon">⚙️</span>
                <span>@Loc.GetString("Settings")</span>
            </NavLink>
            <NavLink href="info">
                <span class="nav-icon">ℹ️</span>
                <span>@Loc.GetString("Info")</span>
            </NavLink>
        </div>
        <div class="nav-footer">
            @if (_isPWAInstallable)
            {
                <button class="pwa-install-btn" @onclick="InstallPWA">
                    <span class="pwa-install-icon">📲</span>
                    <span>@Loc.GetString("InstallApp")</span>
                </button>
            }
            <a href="https://play.google.com/store/apps/details?id=com.kuttab.app" target="_blank" class="nav-play-link" title="Get it on Google Play">
                <svg xmlns="http://www.w3.org/2000/svg" width="155" height="46" viewBox="0 0 155 46">
                    <rect width="155" height="46" rx="6" fill="#1a1a1a" stroke="#888" stroke-width="0.8"/>
                    <!-- Play icon -->
                    <polygon points="12,13 12,33 28,23" fill="#4CAF50"/>
                    <line x1="12" y1="13" x2="20" y2="18" stroke="#2196F3" stroke-width="2"/>
                    <line x1="20" y1="18" x2="28" y2="23" stroke="#F44336" stroke-width="2"/>
                    <line x1="12" y1="33" x2="20" y2="28" stroke="#FFEB3B" stroke-width="2"/>
                    <line x1="20" y1="28" x2="28" y2="23" stroke="#4CAF50" stroke-width="2"/>
                    <!-- Text -->
                    <text x="36" y="19" font-family="sans-serif" font-size="9" fill="#cccccc" letter-spacing="0.5">GET IT ON</text>
                    <text x="36" y="35" font-family="sans-serif" font-size="15" font-weight="bold" fill="#ffffff">Google Play</text>
                </svg>
            </a>
        </div>
    </nav>
    
    <main class="main-content">
        <div class="page-content">
            @Body
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        // Set initial text direction based on default language
        var dir = Loc.IsRightToLeft ? "rtl" : "ltr";
        await JS.InvokeVoidAsync("UtilsInterop.setDirection", dir);
        
        // Check for PWA installability
        await CheckPWAInstallable();
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            var dir = Loc.IsRightToLeft ? "rtl" : "ltr";
            await JS.InvokeVoidAsync("UtilsInterop.setDirection", dir);
            StateHasChanged();
        });
    }

    private bool _isMenuOpen = false;
    private System.Timers.Timer? _autoHideTimer;
    private bool _isPWAInstallable = false;

    protected override void OnInitialized()
    {
        // Auto-hide timer - closes menu after 5 seconds of inactivity
        _autoHideTimer = new System.Timers.Timer(5000);
        _autoHideTimer.Elapsed += (s, e) => InvokeAsync(CloseMenu);
        _autoHideTimer.AutoReset = false;
        
        // Close menu when navigation occurs
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(CloseMenu);
    }

    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
        if (_isMenuOpen)
        {
            // Reset auto-hide timer when menu opens
            _autoHideTimer?.Stop();
            _autoHideTimer?.Start();
        }
        StateHasChanged();
    }

    private void CloseMenu()
    {
        if (_isMenuOpen)
        {
            _isMenuOpen = false;
            _autoHideTimer?.Stop();
            StateHasChanged();
        }
    }

    private void OnMenuInteraction()
    {
        // Reset auto-hide timer on any interaction
        if (_isMenuOpen)
        {
            _autoHideTimer?.Stop();
            _autoHideTimer?.Start();
        }
    }

    private async Task CheckPWAInstallable()
    {
        _isPWAInstallable = await JS.InvokeAsync<bool>("PWAInterop.isInstallable");
        if (_isPWAInstallable)
        {
            StateHasChanged();
        }
    }

    private async Task InstallPWA()
    {
        await JS.InvokeVoidAsync("PWAInterop.install");
    }

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLanguageChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _autoHideTimer?.Dispose();
    }
}
