@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService Loc
@inject IJSRuntime JS

<div class="app-container">
    <nav class="nav-side">
        <div class="nav-header">
            <h1>كُتّاب - Kuttab</h1>
        </div>
        <div class="nav-links">
            <NavLink href="" Match="NavLinkMatch.All">
                <span class="nav-icon">📖</span>
                <span>@Loc.GetString("SingleRuleTraining")</span>
            </NavLink>
            <NavLink href="hifz">
                <span class="nav-icon">🧠</span>
                <span>@Loc.GetString("HifzMode") <small style="opacity:0.7; font-size:0.7em;">(@Loc.GetString("Experimental"))</small></span>
            </NavLink>
            <NavLink href="recitation">
                <span class="nav-icon">🎧</span>
                <span>@Loc.GetString("RecitationMode")</span>
            </NavLink>
            <NavLink href="settings">
                <span class="nav-icon">⚙️</span>
                <span>@Loc.GetString("Settings")</span>
            </NavLink>
            <NavLink href="info">
                <span class="nav-icon">ℹ️</span>
                <span>@Loc.GetString("Info")</span>
            </NavLink>
        </div>
        <div class="nav-footer">
            <a href="https://play.google.com/store/apps/details?id=com.kuttab.app" target="_blank" class="nav-play-link" title="Get it on Google Play">
                <svg xmlns="http://www.w3.org/2000/svg" width="155" height="46" viewBox="0 0 155 46">
                    <rect width="155" height="46" rx="6" fill="#1a1a1a" stroke="#888" stroke-width="0.8"/>
                    <!-- Play icon -->
                    <polygon points="12,13 12,33 28,23" fill="#4CAF50"/>
                    <line x1="12" y1="13" x2="20" y2="18" stroke="#2196F3" stroke-width="2"/>
                    <line x1="20" y1="18" x2="28" y2="23" stroke="#F44336" stroke-width="2"/>
                    <line x1="12" y1="33" x2="20" y2="28" stroke="#FFEB3B" stroke-width="2"/>
                    <line x1="20" y1="28" x2="28" y2="23" stroke="#4CAF50" stroke-width="2"/>
                    <!-- Text -->
                    <text x="36" y="19" font-family="sans-serif" font-size="9" fill="#cccccc" letter-spacing="0.5">GET IT ON</text>
                    <text x="36" y="35" font-family="sans-serif" font-size="15" font-weight="bold" fill="#ffffff">Google Play</text>
                </svg>
            </a>
        </div>
    </nav>
    
    <main class="main-content">
        <div class="page-content">
            @Body
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        // Set initial text direction based on default language
        var dir = Loc.IsRightToLeft ? "rtl" : "ltr";
        await JS.InvokeVoidAsync("UtilsInterop.setDirection", dir);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(async () =>
        {
            var dir = Loc.IsRightToLeft ? "rtl" : "ltr";
            await JS.InvokeVoidAsync("UtilsInterop.setDirection", dir);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLanguageChanged;
    }
}
