<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.kuttab.app</ApplicationId>
    <ApplicationVersion>93</ApplicationVersion>
    <ApplicationDisplayVersion>0.93</ApplicationDisplayVersion>
    <!-- Build for ARM32, ARM64, and x86 to support all Android devices and emulators -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Enable assembly compression to reduce APK size -->
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <!-- D8 configuration for bundletool.jar compatibility -->
    <AndroidD8IgnoreWarnings>true</AndroidD8IgnoreWarnings>
  </PropertyGroup>

  <!-- Release-only optimizations for smaller APK -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidR8IgnoreWarnings>true</AndroidR8IgnoreWarnings>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>kuttab-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>kuttab</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>SanaAziz_2016</AndroidSigningKeyPass>
    <AndroidSigningStorePass>SanaAziz_2016</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kuttab.Core/Kuttab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.3" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.0.3" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.8.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
  </ItemGroup>

  <!-- Exclude bundletool.jar from dex inputs - it contains mixed DEX/bytecode content -->
  <Target Name="RemoveBundletoolFromDex" AfterTargets="_DetermineJavaLibrariesToCompile">
    <ItemGroup>
      <_JavaLibrariesToCompileForApp Remove="@(_JavaLibrariesToCompileForApp)" Condition="$([System.String]::Copy('%(Identity)').Contains('bundletool'))" />
    </ItemGroup>
    <Message Text="Removed bundletool.jar from _JavaLibrariesToCompileForApp" Importance="high" />
  </Target>

  <ItemGroup>
    <AndroidAsset Include="Assets\**" />
    <!-- Include localization JSON files as Android assets -->
    <AndroidAsset Include="..\Localization\*.json">
      <Link>Localization/%(FileName)%(Extension)</Link>
    </AndroidAsset>
    <!-- Include donation data from repo root -->
    <AndroidAsset Include="..\donation.json">
      <Link>donation.json</Link>
    </AndroidAsset>
  </ItemGroup>
</Project>