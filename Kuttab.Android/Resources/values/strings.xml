    <string name="info_citations_title">📖 Citations &amp; Sources</string>
    <string name="info_quran_text_title">Quran Uthmani Text</string>
    <string name="info_quran_text_content">This application uses a modified version of the Quran Uthmani text. The original text is sourced from Tanzil.net, which provides a reliable and standardized version of the Holy Quran in Uthmani script.</string>
    <string name="info_quran_text_url">https://tanzil.net/</string>
    
    <string name="info_audio_files_title">Audio Recitations</string>
    <string name="info_audio_files_content">Audio files are sourced from EveryAyah.com, which provides high-quality Quran recitations by various renowned reciters.</string>
    <string name="info_audio_files_url">https://www.everyayah.com/</string>
    
    <string name="info_picture_files_title">Aya Images</string>
    <string name="info_picture_files_content">Quranic Aya images are generated from the standard Madani Mushaf format, optimized for digital display. Aya images are downloaded from EveryAyah.com, which provides high-quality versions of the Holy Mushaf.</string>
    
    <string name="info_usul_ai_title">Tajweed Rules Validation</string>
    <string name="info_usul_ai_content">Usul.ai was utilized for validation and development assistance in creating and testing the Tajweed search rules, ensuring accuracy in pattern detection.</string>
    <string name="info_usul_ai_url">https://usul.ai/</string>
    
    <string name="info_disclaimer_title">⚠️ Important Notice</string>
    <string name="info_training_disclaimer_title">Educational Purpose Only</string>
    <string name="info_training_disclaimer_content">This application is designed for training and educational purposes. It cannot and should not be used as a substitute for learning Tajweed with a qualified Sheikh. Proper Tajweed requires direct guidance from certified teachers.</string>
    <string name="info_general_disclaimer_content">All accomplishments are by the help of Allah SWT. Any errors or mistakes are from us alone. If you find any inaccuracies or have suggestions for improvement, please contact us.</string>
    
