<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#0D3F13">

    <!-- Green Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#4CAF50"
        android:padding="8dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recitation_mode"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_centerInParent="true" />

    </RelativeLayout>

    <!-- Main Content Area (scrollable) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5DC">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:background="#F5F5DC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#F5F5DC">

                <!-- Now Playing Status -->
                <TextView
                    android:id="@+id/nowPlayingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/currentAyaInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="#4CAF50"
                    android:layout_marginBottom="8dp" />

                <!-- Current Aya Text Display -->
                <TextView
                    android:id="@+id/ayaTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="24sp"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="#F5F5F5"
                    android:layout_marginBottom="16dp"
                    android:minHeight="100dp" />

                <!-- Aya Image Preview -->
                <ImageView
                    android:id="@+id/ayaImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- Tajweed Rules Panel -->
        <LinearLayout
            android:id="@+id/tajweedRulesPanelContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tajweedRulesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tajweed Rules"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2C5F2D"
                android:background="#E8F5E9"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FAFAFA"
                android:fillViewport="false"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/tajweedRulesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Bottom Controls Panel -->
        <LinearLayout
            android:id="@+id/bottomControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_green_background"
            android:padding="10dp"
            android:layout_margin="8dp">

            <!-- Row 1: Reciter Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/reciterLabel"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_reciter_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/reciterSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>

            <!-- Row 2: Surah Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/surahLabel"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_surah"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/surahSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>

            <!-- Row 3: Aya Range + Teacher Mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/fromAyaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/from_aya"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginEnd="4dp" />

                <EditText
                    android:id="@+id/fromAyaInput"
                    android:layout_width="52dp"
                    android:layout_height="36dp"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/edit_text"
                    android:padding="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/toAyaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to_aya"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginEnd="4dp" />

                <EditText
                    android:id="@+id/toAyaInput"
                    android:layout_width="52dp"
                    android:layout_height="36dp"
                    android:inputType="number"
                    android:text="7"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/edit_text"
                    android:padding="4dp" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <CheckBox
                    android:id="@+id/teacherModeCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_mode"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D" />
            </LinearLayout>

            <!-- Row 4: Repeat Mode + Repeat Count + Start/Stop icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/repeatModeSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginEnd="4dp" />

                <EditText
                    android:id="@+id/repeatCountInput"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@android:drawable/edit_text"
                    android:padding="4dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/startButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="▶️"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:background="@drawable/btn_android_icon"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="⏹️"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:background="@drawable/btn_android_icon"
                    android:enabled="false" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
