<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Green Header Bar with App Name and Settings Button -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/primary"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/text_headline3"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                android:layout_gravity="start" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/donateButton"
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:src="@drawable/ic_mosque"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/donate_button_description"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageButton
                    android:id="@+id/recitationButton"
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:src="@drawable/ic_headphones"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/recitation_button_description"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageButton
                    android:id="@+id/infoButton"
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:src="@drawable/ic_info"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info_button_description"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:src="@drawable/ic_settings"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_button_description" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

    <!-- Category Selector -->
    <LinearLayout
        android:id="@+id/categoryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/categoryIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="@dimen/icon_size_md"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_marginStart="@dimen/spacing_xs" />
        
        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/IslamicSpinner" />
    </LinearLayout>

    <!-- Rule Selector -->
    <LinearLayout
        android:id="@+id/ruleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/ruleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖"
            android:textSize="@dimen/icon_size_md"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_marginStart="@dimen/spacing_xs" />
        
        <Spinner
            android:id="@+id/ruleSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/IslamicSpinner" />
    </LinearLayout>

    <!-- Search and Rule Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchButton"
            style="@style/IslamicButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="@string/search"
            app:icon="@drawable/ic_search"
            app:iconGravity="start"
            app:iconPadding="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs" />

        <Button
            android:id="@+id/ruleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rule_button"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Audio Controls Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            style="@style/IslamicButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/play"
            app:icon="@drawable/ic_play"
            app:iconGravity="start"
            app:iconPadding="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playRepeatButton"
            style="@style/IslamicButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/play_repeat"
            app:icon="@drawable/ic_repeat"
            app:iconGravity="start"
            app:iconPadding="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playAllButton"
            style="@style/IslamicButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/play_all"
            app:icon="@drawable/ic_play"
            app:iconGravity="start"
            app:iconPadding="@dimen/spacing_xs"
            android:enabled="false" />

    </LinearLayout>

    <!-- Stop Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopButton"
        style="@style/IslamicButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop"
        app:icon="@drawable/ic_stop"
        app:iconGravity="start"
        app:iconPadding="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:enabled="false" />

    <!-- User Recording Section -->
    <LinearLayout
        android:id="@+id/recordingSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_recording_section"
        android:padding="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Recording"
            android:textSize="@dimen/text_body1"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <!-- Recording Status and Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/recordingStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No recording"
                android:textSize="@dimen/text_body2"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/recordingDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_body2"
                android:textColor="@color/success"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Recording Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordButton"
                style="@style/IslamicButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Record"
                app:icon="@drawable/ic_mic"
                app:iconGravity="start"
                app:iconPadding="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopRecordingButton"
                style="@style/IslamicButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop"
                app:icon="@drawable/ic_stop"
                app:iconGravity="start"
                app:iconPadding="@dimen/spacing_xs"
                android:enabled="false"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playRecordingButton"
                style="@style/IslamicButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play"
                app:icon="@drawable/ic_play"
                app:iconGravity="start"
                app:iconPadding="@dimen/spacing_xs"
                android:enabled="false"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteRecordingButton"
                style="@style/IslamicButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delete"
                app:icon="@drawable/ic_delete"
                app:iconGravity="start"
                app:iconPadding="@dimen/spacing_xs"
                android:enabled="false"
                android:layout_marginStart="@dimen/spacing_xs" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ready"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:textSize="@dimen/text_body1"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Results RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Aya Image Preview (below the list) -->
    <ImageView
        android:id="@+id/ayaImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    </LinearLayout>
</LinearLayout>