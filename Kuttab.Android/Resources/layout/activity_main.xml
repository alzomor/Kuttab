<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Green Header Bar with App Name and Settings Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#4CAF50"
        android:padding="8dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/donateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🕌"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/recitationButton"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/recitationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🎧"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/infoButton"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/infoButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="ℹ️"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/settingsButton"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⚙️"
            android:textSize="24sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#FFFFFF"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

    <!-- Category Selector -->
    <LinearLayout
        android:id="@+id/categoryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/categoryIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="24sp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp" />
        
        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Rule Selector -->
    <LinearLayout
        android:id="@+id/ruleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/ruleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖"
            android:textSize="24sp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp" />
        
        <Spinner
            android:id="@+id/ruleSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Search and Rule Buttons -->

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ready"
        android:layout_marginBottom="4dp"
        android:textStyle="bold" />

    <!-- Results RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Aya Image Preview (below the list) -->
    <ImageView
        android:id="@+id/ayaImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginTop="8dp"
        android:visibility="gone" />


    <!-- Bottom Horizontal Layout: Audio Controls and User Recording Section -->
    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_green_background"
        android:padding="12dp"
        android:layout_margin="8dp">

        <!-- Audio Controls Section (Reciter) -->
        <LinearLayout
            android:id="@+id/audioControlsSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/reciterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reciter"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2C5F2D"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="▶️"
                    android:layout_marginEnd="2dp"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/playRepeatButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="🔁"
                    android:layout_marginEnd="2dp"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/playAllButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="📋"
                    android:layout_marginEnd="2dp"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="⏹️"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:layout_marginEnd="0dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- User Recording Section -->
        <LinearLayout
            android:id="@+id/recordingSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/yourRecordingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_recording"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2C5F2D"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/recordButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="🎤"
                    android:layout_marginEnd="2dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/stopRecordingButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="⏹️"
                    android:layout_marginEnd="2dp"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/playRecordingButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="▶️"
                    android:layout_marginEnd="2dp"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/deleteRecordingButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="🗑️"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:gravity="center"
                    android:padding="0dp"
                    android:layout_marginEnd="0dp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </LinearLayout>
</LinearLayout>