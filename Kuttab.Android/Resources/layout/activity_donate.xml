<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕌"
                    android:textSize="48sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/donateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginBottom="8dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/donateSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_subtitle"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PayPal Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/paypalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_via_paypal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/paypalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paypal_description"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="15dp" />

                <Button
                    android:id="@+id/paypalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳 PayPal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#003087"
                    android:backgroundTint="#FFC439"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bank Transfer Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/bankTransferTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_via_bank"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginBottom="12dp" />

                <!-- Bank Details Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F8F9FA"
                    android:padding="15dp"
                    android:layout_marginBottom="10dp">

                    <!-- Account Holder -->
                    <TextView
                        android:id="@+id/accountHolderLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_holder"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bildungs- und Begegnungsverein Freiburg e.V."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <Button
                            android:id="@+id/copyAccountHolderButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/copy_button"
                            android:textSize="11sp"
                            android:backgroundTint="#E0E0E0"
                            android:textColor="#333333"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </LinearLayout>

                    <!-- IBAN -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IBAN:"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DE11 6805 0101 0014 3501 24"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <Button
                            android:id="@+id/copyIbanButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/copy_button"
                            android:textSize="11sp"
                            android:backgroundTint="#E0E0E0"
                            android:textColor="#333333"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </LinearLayout>

                    <!-- BIC -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BIC:"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FRSPDE66XXX"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="8dp" />

                    <!-- Payment Reference -->
                    <TextView
                        android:id="@+id/paymentReferenceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_reference"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Spende BBF-Bauprojekt | über die App Kuttab"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C5F2D" />

                        <Button
                            android:id="@+id/copyReferenceButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/copy_button"
                            android:textSize="11sp"
                            android:backgroundTint="#E0E0E0"
                            android:textColor="#333333"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </LinearLayout>

                    <!-- Translations -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🇬🇧 Donation to BBF Building Project | via the App Kuttab"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🇸🇦 تبرع لمشروع بناء BBF | عبر تطبيق كُتّاب"
                        android:textSize="11sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bankTransferNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bank_transfer_note"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="italic" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Association Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/aboutAssociationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_association"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/associationDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/association_description"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/taxDeductionNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tax_deduction_note"
                    android:textSize="13sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/associationLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 https://bbfverein.de/"
                    android:textSize="14sp"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Barakah Message Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/barakahMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/barakah_message"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="جَزَاكُمُ ٱللَّهُ خَيْرًا"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2C5F2D"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Share Donation Info Button -->
        <Button
            android:id="@+id/shareDonationInfoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Share Donation Info"
            android:textColor="#FFFFFF"
            android:background="#2C5F2D"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:textStyle="bold"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
